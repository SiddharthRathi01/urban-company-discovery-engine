# Copy to .env (git-ignored). Never commit real credentials. Cloudflare Workers AI is the only LLM provider.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional (defaults shown)
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Free plan = 10,000 neurons/day (resets 00:00 UTC). Requests stop when this budget is reached.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
# Reviews analysed per uploaded CSV, and parallel requests
MAX_ANALYSIS_REVIEWS=300
CLOUDFLARE_CONCURRENCY=3

# Public site mode (default on): visitors' files are analysed temporarily and never stored; the official files are read-only. Use 0 only on your own computer.
PUBLIC_MODE=1
